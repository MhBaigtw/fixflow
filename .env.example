# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://fixflow:CHANGE_ME@localhost:5432/fixflow
# Password for all seed_demo users. Pick your own.
DEMO_PASSWORD=CHANGE_ME
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
# Throttling (DRF rate strings: N/sec, N/min, N/hour, N/day)
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REFRESH_RATE=10/min
THROTTLE_WRITE_RATE=60/min
# Number of reverse proxies in front of the app (0 locally; see docs/deploy.md)
NUM_PROXIES=0
